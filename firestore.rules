rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ─────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;

      // Categories are stored as a subcollection under each user
      match /categories/{catId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // ── Tasks ─────────────────────────────────────────────────────
    match /tasks/{taskId} {
      // Only the owner can read, update, or delete their tasks
      allow read, update, delete: if request.auth.uid == resource.data.uid;
      // Any authenticated user can create (uid is written into the document)
      allow create: if request.auth != null;
    }
  }
}
